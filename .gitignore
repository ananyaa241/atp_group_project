# Root-level .gitignore for MediCare+ Hospital Management System

# ─── Node modules ────────────────────────────────
node_modules/
**/node_modules/

# ─── Environment variables (NEVER commit these) ──
.env
**/.env
.env.local
.env.production
.env.staging

# ─── Build output ────────────────────────────────
dist/
build/
.cache/

# ─── OS & Editor files ───────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# ─── IDE configs ─────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ─── Logs ────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Coverage ────────────────────────────────────
coverage/
.nyc_output/

# ─── Misc ────────────────────────────────────────
*.zip
*.tar.gz
