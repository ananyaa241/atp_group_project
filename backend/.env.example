# ─── Server ──────────────────────────────────────
PORT=5000

# ─── MongoDB ─────────────────────────────────────
# Local MongoDB (default)
DB_URL=mongodb://127.0.0.1:27017/hospital

# OR use MongoDB Atlas (cloud) — replace with your connection string:
# DB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hospital?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────
# Use any long random string (minimum 32 characters recommended)
JWT_SECRET=replace_with_a_long_random_secret_key_here

# ─── Email (Nodemailer via Gmail) ─────────────────
# Use a Gmail address. Generate an App Password at:
# https://myaccount.google.com/apppasswords
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_character_app_password

# ─── Cloudinary (optional — for profile image uploads) ───
# Create a free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
